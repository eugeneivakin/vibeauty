  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const categoriesButton = document.querySelector('.header-categories__button');
    const categoriesMenu = document.querySelector('.categories-menu');
    const categoriesLink = document.querySelectorAll('.categories-menu__link');
    const overlayBlock = document.querySelector('.overlay-categories');
    const categoriesWrapper = document.querySelector('.header-custom-menu');
    let prevCategoriesLink = null;

    categoriesButton.addEventListener('click', function(event) {
        event.stopPropagation(); 
        categoriesMenu.classList.toggle('active');
        overlayBlock.classList.toggle('active');
        categoriesButton.classList.toggle('active');
        if(categoriesButton.classList.contains('active')) {
          categoriesWrapper.style.zIndex = '1';
        } else {
          categoriesWrapper.style.zIndex = '-1';
        }
    });

    categoriesLink.forEach(link => {
        link.addEventListener('mouseover', function() {
            const submenu = link.nextElementSibling;
            if (submenu && submenu.classList.contains('submenu-categories')) {
                submenu.classList.add('active');

                if (prevCategoriesLink && prevCategoriesLink !== link) {
                    prevCategoriesLink.nextElementSibling?.classList.remove('active');
                }
                prevCategoriesLink = link;
            }
        });
    });

    document.addEventListener('click', function(event) {
      if (!categoriesMenu.contains(event.target) && categoriesMenu.classList.contains('active')) {
        categoriesMenu.classList.remove('active');
        overlayBlock.classList.remove('active');
        categoriesButton.classList.remove('active');
        if(categoriesButton.classList.contains('active')) {
          categoriesWrapper.style.zIndex = '1';
        } else {
          categoriesWrapper.style.zIndex = '-1';
        }
        if (prevCategoriesLink) {
            prevCategoriesLink.nextElementSibling?.classList.remove('active');
            prevCategoriesLink = null;
        }
      }
    });
});

</script>


