{% style %}
  #shopify-section-{{ section.id }} .two-column {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{section.id}} .two-column__header{
    color: {{ section.settings.header_color }};
    font-weight: {{ section.settings.header_font_weight }};
    padding-bottom: {{ section.settings.header_padding_bottom }}px;
    font-size: 24px;
    line-height: 1.5;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .two-column {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    #shopify-section-{{section.id}} .two-column__header{
      padding-bottom: {{ section.settings.header_padding_bottom_mobile }}px;
      font-size: 20px;
    }
  }
  {% for block in section.blocks %}
    .item-column--{{ block.id }} .item-column__title {
      color: {{ block.settings.title_color }};
      font-weight: {{ block.settings.title_font_weight }};
    }
    .item-column--{{ block.id }} .item-column__description {
      color: {{ block.settings.description_color }};
    }
    .item-column--{{ block.id }} .title_icon_1 {
      width: {{ block.settings.title_icon_width_1 }}px;
      height: {{ block.settings.title_icon_height_1 }}px;
    }
    .item-column--{{ block.id }} .title_icon_2 {
      width: {{ block.settings.title_icon_width_2 }}px;
      height: {{ block.settings.title_icon_height_2 }}px;
    }
    .item-column--{{ block.id }} .title_icon_3 {
      width: {{ block.settings.title_icon_width_3 }}px;
      height: {{ block.settings.title_icon_height_3 }}px;
    }
    @media(max-width: 768px){
      .item-column--{{ block.id }} .title_icon_1 {
      width: {{ block.settings.title_icon_width_mobile_1 }}px;
      height: {{ block.settings.title_icon_height_mobile_1 }}px;
    }
    .item-column--{{ block.id }} .title_icon_2 {
      width: {{ block.settings.title_icon_width_mobile_2 }}px;
      height: {{ block.settings.title_icon_height_mobile_2 }}px;
    }
    .item-column--{{ block.id }} .title_icon_3 {
      width: {{ block.settings.title_icon_width_mobile_3 }}px;
      height: {{ block.settings.title_icon_height_mobile_3 }}px;
    }
    }
  {% endfor %}
{% endstyle %}
<div class="two-column">
  <div class="page-width">
    {% unless section.settings.header == blank %}
      <div class="two-column__header">
        {{ section.settings.header }}
      </div>
    {% endunless %}
    <div class="two-column__container">
      {% for block in section.blocks %}
        <div class="two-column__item item-column item-column--{{ block.id }}">
          <div class="item-column__top">
            {% unless block.settings.title == blank %}
              <div class="item-column__title">
                {{ block.settings.title }}
              </div>
            {% endunless %}
            <div class="item-column__icons">
              {% for index in (1..3) %}
                {% assign icon_handle = 'title_icon_' | append: index %}
                {% unless block.settings[icon_handle] == blank %}
                  {{
                    block.settings[icon_handle]
                    | image_url: width: block.settings[icon_handle].width
                    | image_tag: class: icon_handle, alt: block.settings[icon_handle].alt
                  }}
                {% endunless %}
              {% endfor %}
            </div>
          </div>
          {% unless block.settings.description == blank %}
            <div class="item-column__description">
              {{ block.settings.description }}
            </div>
          {% endunless %}
          {% unless block.settings.image == blank %}
            <div class="item-column__image">
              {{
                block.settings.image
                | image_url: width: block.settings.image.width
                | image_tag: alt: block.settings.image.alt
              }}
            </div>
          {% endunless %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>
<style>
  .two-column__container {
    display: flex;
    justify-content: space-between;
  }
  .two-column__item {
    width: 100%;
    max-width: 48.5%;
    display: flex;
    flex-direction: column;
  }
  .item-column__top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    min-height: 82px;
  }
  .item-column__title {
    font-size: 20px;
    letter-spacing: 0.15px;
    padding: 16px 0;
  }
  .item-column__icons {
    padding-top: 15px;
    display: flex;
    gap: 25px;
  }
  .item-column__icons img {
    object-fit: contain;
  }
  .item-column__description ul {
    padding-left: 20px;
    padding-bottom: 30px;
    margin: 0;
  }
  .item-column__description li {
    font-size: 14px;
  }
  .item-column__image {
    display: flex;
    align-items: end;
    flex-grow: 1;
  }
  .item-column__image  img{
    width: 100%;
    height:218px;
    object-fit: cover;
  }
  @media (max-width: 1400px) {
    .item-column__title {
      width: 100%;
    }
    .item-column__icons {
      padding-top: 0;
      padding-bottom: 15px;
    }
  }
  @media (max-width: 768px) {
    .item-column__title { 
      font-size: 18px;
    }
    .two-column__container {
      flex-wrap: wrap;
    }
    .two-column__item {
      max-width: 100%;
    }
    .item-column__icons {
      gap: 20px
    }
  }
</style>
