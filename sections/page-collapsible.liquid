{% if section.settings.page.content != blank %}
  {{ 'section-main-page.css' | asset_url | stylesheet_tag }}
  {{ 'component-read-more.css' | asset_url | stylesheet_tag }}
  {{ 'section-page-collapsible.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'read-more.js' | asset_url }}" defer="defer"></script>

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }
    }
    #shopify-section-{{ section.id }} .page-title {
      font-size: {{ section.settings.heading_size }}px;
      color: #414141;
      margin-bottom: 52px;
    }
    #shopify-section-{{ section.id }} .page-title:after {
      content: '';
      height: 5px;
      margin-top: 20px;
      width: 50%;
      background: #96B2A1;
      display: block;
    }
    #shopify-section-{{ section.id }} p {
      color: #8f90a6;
      font-size: 14px;
      line-height: 16px;
      padding-bottom: 18px;
      margin: 0;
    }
    #shopify-section-{{ section.id }} h4 {
      font-size: 14px;
      font-weight: 700;
    }
  {%- endstyle -%}

  <div class="page-width section-{{ section.id }}-padding">
    <h2 class="page-title{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.page.title != blank -%}
        {{ section.settings.page.title | escape }}
      {%- else -%}
        {{ 'sections.page.title' | t }}
      {%- endif -%}
    </h2>
    <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.page.content != blank -%}
        <read-more>
          <div data-content-short>
            <p>{{ section.settings.page.content | strip_html | truncatewords: section.settings.truncate }}</p>
          </div>
          <div data-content-full>
            {{ section.settings.page.content }}
          </div>
          <button data-content-switcher>
            <span>{{ 'sections.page_collapsible.read_more' | t }}</span>
            <span>{{ 'sections.page_collapsible.read_less' | t }}</span>
          </button>
        </read-more>
      {%- else -%}
        <div class="page-placeholder-wrapper placeholder">
          {{ 'page' | placeholder_svg_tag: 'page-placeholder' }}
        </div>
      {%- endif -%}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:sections.page_collapsible.name",
  "tag": "section",
  "class": "section section-page-collapsible",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "number",
      "id": "truncate",
      "label": "Number of words for a short description",
      "default": 100
    },
    {
      "type": "page",
      "id": "page",
      "label": "t:sections.page_collapsible.settings.page.label"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "step": 1,
      "min": 8,
      "max": 100,
      "default": 24
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding top (Mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding bottom (Mobile)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.page_collapsible.presets.name",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
