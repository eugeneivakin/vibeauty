{% if section.blocks.size > 0 %}
  {{ 'content-with-benefits.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    #shopify-section-{{ section.id }} {
      background: {{ section.settings.section_background }};
      color: {{ section.settings.section_color }};
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="page-width section-{{ section.id }}-padding">
    <div class="content-with-benefits__grid">
      {% for block in section.blocks %}
        <div class="content-with-benefits__grid-item">
          <div class="benefit__icon">
            {% if block.settings.icon != blank %}
              {{ block.settings.icon | image_url: height: 120 | image_tag: alt: block.settings.icon.alt }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>
          {% unless block.settings.heading == blank %}
            <h3>{{ block.settings.heading }}</h3>
          {% endunless %}

          {% unless block.settings.content == blank %}
            <div class="benefit__content rte">
              {{ block.settings.content }}
            </div>
          {% endunless %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Benefits",
  "tag": "section",
  "class": "content-with-benefits",
  "settings": [
    {
      "type": "header",
      "content": "Section general settings"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#96B2A1"
    },
    {
      "type": "color",
      "id": "section_color",
      "label": "Section text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section settings for desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Section Padding top",
      "step": 1,
      "min": 0,
      "max": 100,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Section Padding bottom",
      "step": 2,
      "min": 0,
      "max": 200,
      "default": 50,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Section settings for mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Section Padding Top",
      "step": 2,
      "min": 0,
      "max": 200,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Section Padding bottom",
      "step": 2,
      "min": 0,
      "max": 200,
      "default": 50,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Content</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        }
      ]
    }
  ]
}
{% endschema %}
