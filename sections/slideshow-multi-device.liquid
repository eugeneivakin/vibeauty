<!-- sections/slideshow-multi-device.liquid -->
{% schema %}
{
  "name": "Responsive Slideshow",
  "class": "slideshow-multi-device",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "default": "scheme_1",
          "label": "Color scheme"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "image_tablet",
          "label": "Tablet image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Responsive Slideshow",
      "category": "Banners"
    }
  ]
}
{% endschema %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
{{ 'slideshow-multi-device.css' | asset_url | stylesheet_tag }}

<div class="page-width">
  <div class="slideshow-container swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% assign desktop = block.settings.image_desktop %}
        {% assign tablet = block.settings.image_tablet %}
        {% assign mobile = block.settings.image_mobile %}
        <div class="swiper-slide color-{{ block.settings.color_scheme }}">
          {% if block.settings.heading != blank
            and block.settings.subheading != blank
            and block.settings.cta_label != blank
          %}
            <div class="slide__content">
              {% unless block.settings.heading == blank %}
                <h1>{{ block.settings.heading }}</h1>
              {% endunless %}

              {% unless block.settings.subheading == blank %}
                <h2>{{ block.settings.subheading }}</h2>
              {% endunless %}

              <div class="slide__cta-wrapper">
                <a
                  href="{{ block.settings.link }}"
                  {% unless block.settings.cta_label == blank %}
                    class="button"
                  {% else %}
                    class="button--empty"
                  {% endunless %}
                >
                  {{- block.settings.cta_label -}}
                </a>
              </div>
            </div>
          {% endif %}
          <div class="slide__media">
            <a href="{{ block.settings.link }}" class="slide-link">
              <picture>
                {% if mobile %}
                  <source media="(max-width: 767px)" srcset="{{ mobile | img_url: 'master' }}">
                {% endif %}
                {% if tablet %}
                  <source media="(max-width: 1024px)" srcset="{{ tablet | img_url: 'master' }}">
                {% endif %}
                {% if desktop %}
                  <img src="{{ desktop | img_url: 'master' }}" alt="{{ block.settings.alt_text }}">
                {% endif %}
              </picture>
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
    <!-- Pagination -->
    <div class="swiper-pagination"></div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.slideshow-container', {
      loop: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      slidesPerView: 1,
    });
  });
</script>

<style>
  .slideshow-container {
    position: relative;
    width: 100%;
  }

  .swiper-slide picture,
  .swiper-slide img {
    width: 100%;
    display: block;
  }

  .slide-link {
    display: block;
    text-decoration: none;
  }

  .swiper-pagination {
    bottom: 10px !important;
  }
  .swiper-pagination-bullet-active {
    background: #5b886c !important;
  }
</style>
