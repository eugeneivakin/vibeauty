{% style %}
  #shopify-section-{{ section.id }} .banner-with-link{
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media(max-width: 768px) {
      #shopify-section-{{ section.id }} .banner-with-link{
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
  .banner-with-link__image {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
{% endstyle %}
<div class="banner-with-link">
  <div class="page-width">
    {% unless section.settings.link == blank %}
      <a href="{{ section.settings.link }}">
        {% unless section.settings.image == blank %}
          {{
            section.settings.image
            | image_url: width: section.settings.image.width, height: section.settings.image.height
            | image_tag: class: 'banner-with-link__image', alt: section.settings.image.alt
          }}
        {% endunless %}
      </a>
    {% endunless %}
  </div>
</div>

{% schema %}
{
  "name": "Banner with link",
  "settings": [
    {
      "type": "header",
      "content": "General settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Section settings for desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Section Padding top",
      "step": 2,
      "min": 0,
      "max": 200,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Section Padding bottom",
      "step": 2,
      "min": 0,
      "max": 200,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section settings for mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Section Padding Top",
      "step": 2,
      "min": 0,
      "max": 200,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Section Padding bottom",
      "step": 2,
      "min": 0,
      "max": 200,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Banner with link"
    }
  ]
}
{% endschema %}
